# Copy to .env and fill in for local development.
# config/settings/base.py reads all of these via django-environ.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=mysql://root:root@localhost:3306/dbc_backend
DATABASE_CONN_MAX_AGE=60

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Public URL of THIS backend — used to build public card/QR links.
PUBLIC_BASE_URL=http://localhost:8000
# Where the React dashboard SPA is hosted — used in transactional email links.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox

SASAPAY_CLIENT_ID=
SASAPAY_CLIENT_SECRET=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com
RESEND_API_KEY=

SMS_API_KEY=
SMS_SENDER_ID=

SENTRY_DSN=
